{
  "title": "DECkeys — LK201/LK401",
  "mode": "bytes",
  "keyWidth": 54,
  "keyHeight": 40,
  "gap": 5,
  "legendSet": "EDT",

  "//edit": "Edit this file and relaunch — no rebuild, no re-granting.",
  "//escapes": "\\e = ESC, \\r = CR, \\n = LF, \\t = TAB, \\\\ = backslash.",
  "//layout": "Four columns throughout. F-keys flow F6-F20 in rows of four; the",
  "//layout2": "editing keypad keeps the real 3+3 grouping (Find Ins Rem / Sel",
  "//layout3": "Prev Next); the numeric keypad is laid out as on the plastic.",
  "//omitted": "F1-F5 are LOCAL keys on a real VT and never transmit — Set-Up,",
  "//omitted2": "session switch etc. Compose and Lock are local too (LK201 sends",
  "//omitted3": "them to the TERMINAL, not the host). Arrows: a laptop has them.",
  "//dark": "dark:true = the darker grey DEC moulded the function row and",
  "//dark2": "the editing keypad in. Cosmetic; the numeric keypad stays pale.",
  "//f15": "Help and Do occupy the F15/F16 positions and send \\e[28~ and",
  "//f16": "\\e[29~ — but DEC never printed F15/F16 on them. The caps say",
  "//f17": "Help and Do, so that is what they say here. Do is double-wide.",
  "//verified": "F6=17 F10=21 F14=26 F15=28 F16=29 F17=31 F20=34 were MEASURED",
  "//verified2": "through ezalb with `cat -v`. The rest follow the same DEC table.",
  "//keypad": "Numeric keypad codes are APPLICATION keypad mode (ESC O x), which",
  "//keypad2": "is what EDT, EVE and DEC Notes put the terminal in. At a bare DCL",
  "//keypad3": "prompt these will look wrong — that is correct behaviour.",

  "//legends": "The second legend printed on a real DEC keycap. APPLICATION-",
  "//legends2": "specific, not a property of the key: the same KP4 sends ESC O t",
  "//legends3": "either way, but it is ADVANCE to EDT and Word to WPS-PLUS.",
  "//legends4": "Nothing here changes what is transmitted. The Gold-shifted",
  "//legends5": "function (the red legend on the cap) shows as a tooltip.",
  "//legends6": "VERIFIED 2026-08-04 against EVE's own GOLD-HELP keypad diagram",
  "//legends7": "on MESSEL — transcribed from the screen, not from memory. These",
  "//legends8": "are EVE's EDT-keypad emulation, which differs from stock EDT in",
  "//legends9": "places: KP4/KP5 are Forward/Reverse (EDT calls them ADVANCE and",
  "//legendsA": "BACKUP), KP6 is Remove/Ins Here (EDT: CUT/PASTE), and the undelete",
  "//legendsB": "functions are Res Lin/Wor/Cha rather than UND L/W/C.",
  "//legendsC": "Handy: GOLD-KP7 is a synonym for DO, so the command line is",
  "//legendsD": "reachable without F16. Arrows (not on this panel — a laptop has",
  "//legendsE": "them) take GOLD too: Top, Bottom, StaOfLi, EndOfLi.",
  "//notes": "NOTES is transcribed from Introduction to VAX Notes, Figure 1-1",
  "//notes2": "(ZK-4673-85) — the printed manual, not a screen capture. PF3 and",
  "//notes3": "KP8/KP9/KP4/KP6 are genuinely unused in Notes; blank caps are",
  "//notes4": "information, not omissions. The figure shows no Gold layer.",
  "//mail": "MAIL is transcribed from the VMS MAIL keypad figure ZK-1744-84.",
  "//mail2": "Every key there carries a Gold function too — hover for it.",
  "//conv": "conv:true = NOT an LK201 key, but a convenience. Control chars",
  "//conv2": "VMS leans on constantly. Tinted so the panel never pretends to",
  "//conv3": "be reproducing hardware. \\cZ = Ctrl-Z; sent as letter+Control.",

  "legends": {
    "EDT": {
      "PF1":  { "legend": "GOLD", "goldCap": true },
      "PF2":  { "legend": "HELP" },
      "PF3":  { "legend": "FNDNXT",  "gold": "FIND" },
      "PF4":  { "legend": "DEL L",   "gold": "UND L" },
      "7":    { "legend": "PAGE",    "gold": "COMMAND" },
      "8":    { "legend": "SECT",    "gold": "FILL" },
      "9":    { "legend": "APPEND",  "gold": "REPLACE" },
      "-":    { "legend": "DEL W",   "gold": "UND W" },
      "4":    { "legend": "ADVANCE", "gold": "BOTTOM" },
      "5":    { "legend": "BACKUP",  "gold": "TOP" },
      "6":    { "legend": "CUT",     "gold": "PASTE" },
      ",":    { "legend": "DEL C",   "gold": "UND C" },
      "1":    { "legend": "WORD",    "gold": "CHNGCASE" },
      "2":    { "legend": "EOL",     "gold": "DEL EOL" },
      "3":    { "legend": "CHAR",    "gold": "SPECINS" },
      "Entr": { "legend": "ENTER",   "gold": "SUBS" },
      "0":    { "legend": "LINE",    "gold": "OPEN LINE" },
      ".":    { "legend": "SELECT",  "gold": "RESET" },
      "^C":   { "legend": "Cancel" }
    },
    "MAIL": {
      "PF1":  { "legend": "GOLD", "goldCap": true },
      "PF2":  { "legend": "HELP",    "gold": "DIR/FOLDER" },
      "PF3":  { "legend": "EXTRACT", "note": "EXTRACT/MAIL", "gold": "EXTRACT" },
      "PF4":  { "legend": "ERASE",   "gold": "SELECT/MAIL" },
      "7":    { "legend": "SEND",    "gold": "SEND/EDIT" },
      "8":    { "legend": "REPLY",   "gold": "REP/EDIT/EXT" },
      "9":    { "legend": "FORWARD", "gold": "FORWARD/EDIT" },
      "-":    { "legend": "READ/NEW","gold": "SHOW/NEW" },
      "4":    { "legend": "CURRENT", "gold": "CURRENT/EDIT" },
      "5":    { "legend": "FIRST",   "gold": "FIRST/EDIT" },
      "6":    { "legend": "LAST",    "gold": "LAST/EDIT" },
      ",":    { "legend": "DIR/NEW", "gold": "DIR MAIL" },
      "1":    { "legend": "BACK",    "gold": "BACK/EDIT" },
      "2":    { "legend": "PRINT",   "gold": "PRINT/PR/NOT" },
      "3":    { "legend": "DIR",     "gold": "DIR/ST=99999" },
      "Entr": { "legend": "SELECT" },
      "0":    { "legend": "NEXT",    "gold": "NEXT/EDIT" },
      ".":    { "legend": "FILE",    "gold": "DELETE" }
    },
    "NOTES": {
      "PF1":  { "legend": "GOLD", "goldCap": true },
      "PF2":  { "legend": "HELP" },
      "PF4":  { "legend": "NUM/CMDS", "note": "NUMERIC / COMMANDS" },
      "7":    { "legend": "SELECT" },
      "-":    { "legend": "PREV NOTE", "note": "PREVIOUSLY DISPLAYED NOTE" },
      "5":    { "legend": "BACK TOPIC" },
      ",":    { "legend": "NEXT UNSEEN" },
      "1":    { "legend": "BACK REPLY" },
      "2":    { "legend": "NEXT TOPIC" },
      "3":    { "legend": "NEXT REPLY" },
      "Entr": { "legend": "ENTER", "note": "One-key reading, or command-line terminator" },
      "0":    { "legend": "NEXT SCREEN" },
      ".":    { "legend": "PREV SCREEN" }
    },
    "EVE-EDT": {
      "^B":   { "legend": "Recall" },
      "^E":   { "legend": "End Line" },
      "^R":   { "legend": "Remember" },
      "^U":   { "legend": "Erase>Sta", "note": "Erase to start of line" },
      "^V":   { "legend": "Quote" },
      "^W":   { "legend": "Refresh" },
      "^Z":   { "legend": "Exit" },
      "PF1":  { "legend": "Gold key", "goldCap": true },
      "PF2":  { "legend": "HELP",    "gold": "KeyDefs" },
      "PF3":  { "legend": "FndNxt",  "gold": "Find" },
      "PF4":  { "legend": "Del L",   "gold": "Res Lin" },
      "7":    { "legend": "MovByPa", "gold": "Do" },
      "8":    { "legend": "Sect",    "gold": "Fill" },
      "9":    { "legend": "Append",  "gold": "EDT Rep" },
      "-":    { "legend": "Del W",   "gold": "Res Wor" },
      "4":    { "legend": "Forward", "gold": "Bottom" },
      "5":    { "legend": "Reverse", "gold": "Top" },
      "6":    { "legend": "Remove",  "gold": "Ins Here" },
      ",":    { "legend": "Del C",   "gold": "Res Cha" },
      "1":    { "legend": "Word",    "gold": "ChngCas" },
      "2":    { "legend": "EOL",     "gold": "Del EOL" },
      "3":    { "legend": "Char",    "gold": "SpecIns" },
      "Entr": { "legend": "Return",  "gold": "Subs" },
      "0":    { "legend": "EDT Line","gold": "Open Line" },
      ".":    { "legend": "Select",  "gold": "Reset" }
    }
  },

  "keys": [
    { "label": "F6",   "row": 0, "bytes": "\\e[17~" , "dark": true },
    { "label": "F7",   "row": 0, "bytes": "\\e[18~" , "dark": true },
    { "label": "F8",   "row": 0, "bytes": "\\e[19~" , "dark": true },
    { "label": "F9",   "row": 0, "bytes": "\\e[20~" , "dark": true },

    { "label": "F10",  "row": 1, "bytes": "\\e[21~" , "dark": true },
    { "label": "F11",  "row": 1, "bytes": "\\e[23~" , "dark": true },
    { "label": "F12",  "row": 1, "bytes": "\\e[24~" , "dark": true },
    { "label": "F13",  "row": 1, "bytes": "\\e[25~" , "dark": true },

    { "label": "F14",  "row": 2, "bytes": "\\e[26~" , "dark": true },
    { "label": "Help", "row": 2, "bytes": "\\e[28~" , "dark": true },
