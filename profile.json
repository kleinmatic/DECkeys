    { "label": "Next", "row": 5, "bytes": "\\e[6~" , "dark": true },

    { "label": "PF1",  "row": 6, "bytes": "\\eOP" },
    { "label": "PF2",  "row": 6, "bytes": "\\eOQ" },
    { "label": "PF3",  "row": 6, "bytes": "\\eOR" },
    { "label": "PF4",  "row": 6, "bytes": "\\eOS" },

    { "label": "7",    "row": 7, "bytes": "\\eOw" },
